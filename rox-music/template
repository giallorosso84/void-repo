hostmakedepends="pkg-config cmake tar patch"
makedepends="wayland-devel libxkbcommon-devel libxcb-devel libX11-devel vulkan-loader-devel libglvnd-devel fontconfig-devel freetype-devel alsa-lib-devel oniguruma-devel sqlite-devel openssl-devel zlib-devel"

export LASTFM_API_KEY="88e26d5b524f6a7b61734350d32afc32"
export LASTFM_API_SECRET="51ece542496dc6b5641eb3feb2735f3b"
export DISCORD_APPLICATION_ID="1531533372051030036"
export ACOUSTID_CLIENT_KEY="NM7UnN9N7Z"

post_patch() {
  [ -d rox-1.34.1 ] && cd rox-1.34.1
  export LC_ALL=C
  mkdir -p vendor
  # gpui
  mkdir -p vendor/gpui
  tar -xzf ${XBPS_SRCDISTDIR}/rox-music-1.34.1/gpui-0.2.2.crate -C vendor/gpui --strip-components=1
  for p in patches/gpui/*.patch; do
    patch -p1 -F0 -d vendor/gpui --no-backup-if-mismatch --quiet < "$p"
  done
  # gpui-component
  mkdir -p vendor/gpui-component
  tar -xzf ${XBPS_SRCDISTDIR}/rox-music-1.34.1/gpui-component-0.5.1.crate -C vendor/gpui-component --strip-components=1
  for p in patches/gpui-component/*.patch; do
    patch -p1 -F0 -d vendor/gpui-component --no-backup-if-mismatch --quiet < "$p"
  done
  # projectm
  mkdir -p vendor/projectm
  tar -xzf ${XBPS_SRCDISTDIR}/rox-music-1.34.1/88f23c76743a38c6d8456a8c354c62186270f661.tar.gz -C vendor/projectm --strip-components=1
  mkdir -p vendor/projectm/vendor/projectm-eval
  tar -xzf ${XBPS_SRCDISTDIR}/rox-music-1.34.1/22fb0cfd8f2dfbcd2b68f2443e7f44e19b32c09a.tar.gz -C vendor/projectm/vendor/projectm-eval --strip-components=1
  for p in patches/projectm/*.patch; do
    patch -p1 -F0 -d vendor/projectm --no-backup-if-mismatch --quiet < "$p"
  done
}

post_install() {
  [ -d rox-1.34.1 ] && cd rox-1.34.1
  vinstall crates/rox/assets/app/rox.desktop 644 usr/share/applications
  vinstall crates/rox/assets/app/rox-music.svg 644 usr/share/icons/hicolor/scalable/apps rox.svg
  vinstall crates/rox/assets/app/rox.png 644 usr/share/pixmaps rox.png
  vinstall crates/rox/assets/app/rox.metainfo.xml 644 usr/share/metainfo
}
